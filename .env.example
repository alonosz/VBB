# Assisted intake (optional).
#
# With no key set, the product runs exactly as before: columns are matched by
# header heuristics and the report is unchanged. With a key, one call per
# upload proposes a column mapping and writes down the claims made at intake.
# It never computes a value — see principle 5 in CLAUDE.md.
ANTHROPIC_API_KEY=

# Defaults to claude-haiku-4-5-20251001 — the flow only waits a few seconds.
VBB_INTAKE_MODEL=

# Tokenized Google Ads feed (Phase 2).
#
# The privileged key is server-only — it must never reach the browser, so it
# never carries a NEXT_PUBLIC_ prefix. Supabase now calls this a "secret key"
# (sb_secret_…) where it used to say service_role; either environment variable
# name works, and SUPABASE_URL works in place of the NEXT_PUBLIC_ one.
#
# With these unset the diagnostic works unchanged and the feed endpoint reports
# that it is not configured.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CRM sync (optional) ---------------------------------------------------
# With none of these set, the product runs exactly as before: publish a feed by
# hand, Google collects it. Setting them adds the nightly HubSpot sync.
#
# The key that encrypts CRM credentials. 32 bytes, base64 or hex. Generate one
# with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it does not lose data — every connection simply asks to be
# reconnected, which is the same thing that happens if a portal revokes access.
VBB_TOKEN_KEY=
# From a HubSpot developer app: Auth tab, with the three read scopes
# crm.objects.deals.read, crm.objects.contacts.read, crm.objects.companies.read
# and a redirect URL of https://<your-domain>/api/crm/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Shared secret the scheduler sends as `Authorization: Bearer …`. With this
# unset the cron endpoint stays shut rather than falling open.
CRON_SECRET=
# The operator's own password, for /admin — where customers are created. The
# one credential in this product a person has to remember, because creating a
# workspace is what brings a workspace key into existence and so cannot be
# authorised by one. At least 16 characters; below that, and with it unset,
# /admin is closed rather than open.
VBB_ADMIN_KEY=
# The canonical domain feed URLs are built from. Optional: on Vercel we fall
# back to VERCEL_PROJECT_PRODUCTION_URL, which is right for most deployments.
# Set it for a custom domain.
VBB_PUBLIC_ORIGIN=
