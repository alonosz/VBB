# Assisted intake (optional).
#
# With no key set, the product runs exactly as before: columns are matched by
# header heuristics and the report is unchanged. With a key, one call per
# upload proposes a column mapping and writes down the claims made at intake.
# It never computes a value — see principle 5 in CLAUDE.md.
ANTHROPIC_API_KEY=

# Defaults to claude-haiku-4-5-20251001 — the flow only waits a few seconds.
VBB_INTAKE_MODEL=
